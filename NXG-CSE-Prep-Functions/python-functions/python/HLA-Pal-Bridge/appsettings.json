{
  "JwtSettings": {
    "#SecretKey": "Remark: SecretKey is stored in the app secrets",
    "Issuer": "your-app-name",
    "Audience": "your-app-users",
    "ExpiryMinutes": 60
  },
  "Kestrel": {
    "Endpoints": {
      "RemoteEndpoint": {
        "Url": "http://+:6431",
        "Protocols": "Http1AndHttp2",
        "UseHttps": "false"
        },
        "LocalEndpoint": {
          "Url": "http://0.0.0.0:6430",
          "UseHttps": "false",
          "Protocols": "Http2"
       }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.AssemblyName"
    ],
    "Enrich": [
      {
        "Name": "WithMachineName"
      }
    ],
    "WriteTo": [
      {
        "Name": "ColoredConsole"
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Connection": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Transaction": "Warning",
        "Microsoft.EntityFrameworkCore.Update": "Warning",
        "Microsoft.EntityFrameworkCore.Sqlite": "Warning",
        "Microsoft.EntityFrameworkCore.Sqlite.Infrastructure": "Warning",
        "Microsoft.EntityFrameworkCore.Storage": "Warning",
        "Microsoft.EntityFrameworkCore.Sqlite.Storage": "Warning",
        "Accenture.MxP.Module": "Debug",
        "Accenture.MxP.Module.Defense.Hla": "Information",
        "Accenture.MxP.Module.Services.Monitor": "Information",
        "Accenture.MxP.Module.Services.Monitor.Observation": "Information",
        "Accenture.MxP.Module.Services.Monitor.Forwarding": "Debug",
        "Accenture.MxP.Module.Portal.Monitor": "Information"
      }
    }
  },

  "MxP": {
    "Database": {
      "File": "data/database.db"
    },
    "Downloads": {
      "#HINT/1": "Keeping the Folder property empty will revert to using data/downloads in the process folder.",
      "#HINT/3": "In a docker container it can be set to an absolute path, for example: /app/data/downloads",
      "Folder": ""
    },
    "Images": {
      "#HINT/1": "Keeping the Folder property empty will revert to using data/images in the process folder.",
      "#HINT/3": "In a docker container it can be set to an absolute path, for example: /app/data/images",
      "Folder": ""
    },
    "MilSymbol": {
      "#HINT/1": "Keeping the ServerUrl property empty will use the internal MilSymbolServer",
      "#HINT/2": "Run the instructions here to setup a docker container: https://github.com/spatialillusions/milsymbol-server",
      "#HINT/3": "In essence it is:",
      "#HINT/4": "git clone https://github.com/spatialillusions/milsymbol-server --depth 1 --branch=master",
      "#HINT/5": "docker build -t spatialillusions/milsymbol-server:1.0.0 .",
      "#HINT/6": "docker run -d -p 2525:2525 spatialillusions/milsymbol-server:1.0.0",
      "#HINT/7": "After this the service is available at: http://localhost:2525",
      "ServerUrl": ""
    },
    "Api": {
      "#HINT": "Change this setting on systems where the local network IP does not match the internet IP, for example on Virtual Machines",
      "PublicUrl": ""
    },
    "Cesium": {
      "AccessToken": "<REDACTED>"
    },
    "Fusion": {
      "AppIdFusion": "3cdc11d2-cca7-40bf-b56c-512cb2b2115b",
      "AppIdVoice": "e86cca91-6d0e-44d9-827e-d6af0bddc9ea",
      "Region": "us",
      "RoomName": "TestRoom"
    },
    "Dispatching": {
      "IdleDetectionInMilliseconds": 300
    },
    "Ngo": {
      "ServerAddress": "localhost"
    }
  },

  "Simulation": {
    "Hla": {
      "Input": {
        "TestEntities": {
          "Enabled": true,
          "AddAircraft": true,
          "#AddVehicles": true,
          "#AddVessels": true,
          "#AddSubmarines": true
        },
        "Rpr20FomFederate": {
          "Enabled": true
        }
      },
      "Output":
      {
        "#REMARK": "These sections do not do anything yet",
        "SitaWare": {
          "Enabled": true,
          "ForwardEventsUri": "https://1.2.3.4:1234",
          "LayerId": "default:90aca865-23c6-448c-8d4a-ad0a00a3668b",
          "UserName": "<REDACTED>",
          "Password": "<REDACTED>"
        },
        "Immersive": {
          "Enabled": true
        }
      }
    }
  },
