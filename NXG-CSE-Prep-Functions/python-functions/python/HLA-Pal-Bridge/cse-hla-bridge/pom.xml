<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.decho.cse</groupId>
    <artifactId>hla-bridge</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>CSE HLA Bridge</name>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Overridden by the Docker build, which passes the short commit hash as
             -Dgit.sha. Defaulted rather than left unset because build-info rejects an
             empty additional property, and "unknown" is itself the useful answer: it
             means the image was built outside the documented path. -->
        <git.sha>unknown</git.sha>
    </properties>

    <!-- ── Pitch Maven Repository ── -->
    <repositories>
        <repository>
            <id>pitch-releases</id>
            <name>Pitch Public Maven Repository</name>
            <url>https://maven.pitch.se/repository/maven-releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Pitch FedPro HLA Evolved Client — resolves from pitch repo above -->
        <dependency>
            <groupId>se.pitch.oss.fedpro</groupId>
            <artifactId>fedpro-client-hla-evolved</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.decho.cse.bridge.BridgeApplication</mainClass>
                </configuration>
                <executions>
                    <!-- Writes META-INF/build-info.properties, which Spring exposes as a
                         BuildProperties bean. Without it a deployed jar cannot be tied to
                         a commit, and a bridge whose behaviour matches no commit in the
                         repo cannot be reasoned about at all. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <sha>${git.sha}</sha>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>