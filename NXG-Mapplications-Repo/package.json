    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "maplibre-gl": "^5.24.0",
    "milsymbol": "^3.0.4",
    "pmtiles": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.10.0",
